# Copy to .env and fill in. The checks never read .env. The installed app reads no
# .env: its key is in the Keychain and everything else is in Settings.

# Only for a live run.
ANTHROPIC_API_KEY=

# The development vault, built from data/ by `npm run seed`.
SECUREFOLIO_VAULT=./.vault-dev

# Optional: the local model, and where Ollama listens (loopback only).
# LOCAL_MODEL=gemma4:26b
# OLLAMA_HOST=http://127.0.0.1:11434
