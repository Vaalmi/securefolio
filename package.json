{
  "name": "securefolio",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "lefthook install && playwright install chromium && node scripts/fetch-python.mjs",
    "dev": "node scripts/dev.mjs",
    "app": "node scripts/install-app.mjs",
    "dev:desktop": "SECUREFOLIO_DEV_BACKEND=1 tauri dev --config desktop/src-tauri/tauri.conf.json",
    "models": "uv run --env-file .env -m scripts.models.download",
    "seed": "uv run --env-file .env -m data.build.seed",
    "format": "uv run ruff format && prettier --write -u app e2e scripts *.config.*",
    "check": "concurrently -g \"npm:check:*\" && npm run e2e",
    "check:python": "uv run ruff format --check && uv run ruff check && pyright --threads && uv run pytest -q -n auto --dist worksteal",
    "check:app": "uv run --isolated --only-group app python -c \"import backend.main, worker.main\"",
    "check:ts": "prettier --check -u app e2e scripts *.config.* && eslint app e2e scripts *.config.js *.config.ts && tsc && vitest run --root app --coverage",
    "check:rust": "node scripts/check-rust.mjs",
    "check:bundle": "node scripts/bundle.mjs",
    "check:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "e2e": "playwright test",
    "verify:models": "HF_HOME=.cache/models/huggingface HF_HUB_OFFLINE=1 uv run pytest -q --no-cov -m real_models",
    "eval": "SECUREFOLIO_VAULT=${SECUREFOLIO_VAULT:-$PWD/.vault-dev} SECUREFOLIO_MODEL_CACHE=${SECUREFOLIO_MODEL_CACHE:-$PWD/.cache/models} HF_HUB_OFFLINE=1 uv run --env-file .env -m evals.cli",
    "evals:seal": "uv run -m data.build.seal",
    "evals:heldout": "SECUREFOLIO_MODEL_CACHE=${SECUREFOLIO_MODEL_CACHE:-$PWD/.cache/models} HF_HUB_OFFLINE=1 uv run --env-file .env -m evals.heldout"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "lefthook": false,
    "fsevents": false
  }
}
